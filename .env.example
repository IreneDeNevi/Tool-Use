# ── SearXNG ─────────────────────────────────────────────────────────────────
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_SECRET=change-me-before-production
SEARXNG_LANGUAGE=it
# Comma-separated list of engines to use (leave empty for SearXNG defaults)
# SEARXNG_ENGINES=google,bing,duckduckgo

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Read-only token from huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=hf_...
# Model served via the HF Inference API
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Leave CHROMA_HOST empty to use a local PersistentClient (no Docker needed).
# Set CHROMA_HOST to use the chromadb microservice from docker-compose.yml.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_PERSIST_PATH=./memory_store
CHROMA_COLLECTION=research-cache
CHROMA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ONNX Runtime ─────────────────────────────────────────────────────────────
# 0=VERBOSE 1=INFO 2=WARNING 3=ERROR 4=FATAL
# Set to 3 to silence the harmless PCI/VMBUS device-discovery noise on VMs.
ORT_LOGGING_LEVEL=3
